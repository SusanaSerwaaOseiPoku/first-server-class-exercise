# Server port (Render injects PORT automatically in production)
PORT=3002

# Runtime environment: development or production
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Signing secret for JWT tokens (use a NEW secret on Render for production)
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas connection string:
# - Local development: .../notes-dev?retryWrites=true&w=majority
# - Production on Render: .../notes-prod?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/notes-dev?retryWrites=true&w=majority
